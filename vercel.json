{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "app/api/max/webhook/route.ts": { "maxDuration": 30 },
    "app/api/cron/**/route.ts": { "maxDuration": 60 }
  }
}
