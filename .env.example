# ---- MAX ----
# Токены разделены по окружениям Vercel: production -> PROD, preview/development -> DEV
MAX_BOT_TOKEN_PROD=
MAX_BOT_TOKEN_DEV=
# 5-256 символов [a-zA-Z0-9_-]
MAX_WEBHOOK_SECRET=
MAX_API_URL=https://platform-api2.max.ru
# PEM корневого сертификата Russian Trusted CA (нужен на Vercel, см. README). Можно в base64.
MAX_EXTRA_CA_PEM=

# ---- Database (Neon) ----
# Pooled-строка (хост с -pooler) для приложения
# Для Neon pooled добавьте ?pgbouncer=true&connect_timeout=15
DATABASE_URL=
# Прямая строка (без -pooler) для prisma migrate
DIRECT_URL=

# ---- Google Sheets ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Ключ из JSON целиком, переносы строк как \n
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Потолок AI-ответов в сутки на весь бот (по умолчанию 1000)
# AI_DAILY_LIMIT=1000

# MAX user_id администраторов через запятую: сюда приходят уведомления о записях и ошибках
ADMIN_MAX_USER_IDS=

# ---- Security ----
CRON_SECRET=
ADMIN_SESSION_SECRET=

# ---- Salon ----
SALON_TIMEZONE=Asia/Yekaterinburg
SALON_NAME=
SALON_PHONE=
SALON_ADDRESS=
# Оператор персональных данных (юр. лицо / ИП) — попадает на страницы /privacy и /terms
SALON_LEGAL_NAME=
SALON_HOURS=
SALON_WEBSITE=
SALON_SOCIAL_URL=
# Если пусто, используется https://<production-домен Vercel>/privacy
PRIVACY_POLICY_URL=

# ---- Первый администратор (используется ТОЛЬКО скриптом npm run admin:create, потом удалите из окружения) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=   # не короче 12 символов
